datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  auth0Sub    String       @unique
  displayName String?      @db.VarChar(120)
  plans       SocialPlan[]
  people      Person[]

  connectionsAsUser   Connection[]       @relation("connectionUser")
  connectionsAsTarget Connection[]       @relation("connectionTarget")
  connectionInvites   ConnectionInvite[]
  linkedPeople        Person[]           @relation("linkedPeople")
  subscriptions       PlanSubscription[]
}

model Person {
  id          String @id @default(uuid()) @db.Uuid
  ownerId     String @db.Uuid
  owner       User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  linkedUserId String? @db.Uuid
  linkedUser   User?   @relation("linkedPeople", fields: [linkedUserId], references: [id], onDelete: SetNull)

  displayName String @db.VarChar(120)
  pronouns    String? @db.VarChar(80)
  neighborhood String? @db.VarChar(120)
  notes       String? @db.Text

  /// Partial birthday support (year optional).
  birthdayMonth Int?
  birthdayDay   Int?
  birthdayYear  Int?

  /// Soft archive for reversibility (hidden in UI without deletion).
  archivedAt DateTime?

  participants SocialPlanParticipant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, linkedUserId])
  @@index([ownerId, displayName])
  @@index([ownerId, archivedAt, updatedAt])
}

/// SocialPlan is the minimal primitive for "friend plans":
/// social intent + (optional) context + (optional) time anchor + (optional) place + participants.
/// No nudges, reminders, messaging, sharing, recurrence, or RSVP semantics belong here.
model SocialPlan {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// The user's original phrasing / intent:
  /// "let's do lunch Thursday", "gym Monday?", "call sometime this week"
  intentText String @db.Text

  /// Optional private relational context ("why this matters", "what to remember")
  contextNote String? @db.Text

  /// Optional human place phrase ("near Union Sq", "your place?", "that ramen spot")
  locationText String? @db.Text

  /// Open/closed state only. Avoid guilt semantics.
  state SocialPlanState @default(OPEN)

  /// Unified time anchor representation.
  timePrecision SocialPlanTimePrecision @default(UNSPECIFIED)

  /// Anchor start/end interpretation:
  /// - NONE: both null
  /// - WINDOW: [anchorStart, anchorEnd] is a rough range
  /// - EXACT: anchorStart is the start time; anchorEnd optional
  anchorStart DateTime?
  anchorEnd   DateTime?

  /// Optional IANA timezone (e.g., "America/New_York") for interpreting/displaying anchors.
  timezone String? @db.VarChar(64)

  participants  SocialPlanParticipant[]
  shareTokens   ShareToken[]
  subscriptions PlanSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
  @@index([ownerId, state, updatedAt])
  @@index([ownerId, anchorStart])
}

model SocialPlanParticipant {
  id String @id @default(uuid()) @db.Uuid

  planId String     @db.Uuid
  plan   SocialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// MVP: links to the user's private People Library.
  /// SetNull preserves plan readability if a Person is deleted; use displayName as a snapshot.
  personId String? @db.Uuid
  person   Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  /// Optional snapshot so the plan remains readable even if the Person changes/disappears.
  displayName String? @db.VarChar(120)

  /// Helps UI labeling (e.g., the "main" friend in a 1:1 plan) without inventing host/RSVP semantics.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  // prevent duplicate linked person on same plan (nulls are allowed in Postgres)
  @@unique([planId, personId])
  @@index([planId])
}

model Connection {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation("connectionUser", fields: [userId], references: [id], onDelete: Cascade)
  targetId  String   @db.Uuid
  target    User     @relation("connectionTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, targetId])
  @@index([userId])
  @@index([targetId])
}

model ConnectionInvite {
  id        String                 @id @default(uuid()) @db.Uuid
  token     String                 @unique @db.VarChar(64)
  senderId  String                 @db.Uuid
  sender    User                   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  status    ConnectionInviteStatus @default(PENDING)
  createdAt DateTime               @default(now())
  expiresAt DateTime

  @@index([senderId])
}

enum ConnectionInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model ShareToken {
  id        String     @id @default(uuid()) @db.Uuid
  token     String     @unique @db.VarChar(64)
  planId    String     @db.Uuid
  plan      SocialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdBy String     @db.Uuid
  createdAt DateTime   @default(now())
  revokedAt DateTime?

  @@index([planId])
}

model PlanSubscription {
  id        String     @id @default(uuid()) @db.Uuid
  planId    String     @db.Uuid
  plan      SocialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([planId, userId])
  @@index([userId])
  @@index([planId])
}

enum SocialPlanState {
  OPEN
  DONE
  DROPPED
  ARCHIVED
}

enum SocialPlanTimePrecision {
  /// Unknown / not decided yet (keeps ingestion easy)
  UNSPECIFIED

  /// Intentionally unanchored ("call sometime")
  NONE

  /// Rough range ("this weekend", "next week")
  WINDOW

  /// Specific time ("Thursday 12:30")
  EXACT
}

model IdempotencyKey {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @db.Uuid
  key         String
  scope       String   // e.g. "POST /v1/plans"
  requestHash String
  // store the created resource pointer (enough to replay)
  resourceType String?
  resourceId   String?
  createdAt   DateTime @default(now())

  @@unique([ownerId, key, scope])
  @@index([createdAt])
}
